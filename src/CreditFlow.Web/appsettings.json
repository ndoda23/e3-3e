{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "CreditFlow" }
  },
  "DatabaseLog": {
    "Enabled": true,
    "MinimumLevel": "Information",
    "BatchPeriod": "00:00:02"
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02",
    "MaxBackoff": "01:00:00"
  },
  "Jobs": {
    "Enabled": true,
    "Interval": "00:01:00"
  },
  "Mocks": {
    "BureauTimeout": "00:00:02",
    "CoreBankingTimeout": "00:00:02",
    "Scenarios": {}
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CreditFlow": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Security": {
    "IdleTimeout": "00:30:00",
    "AbsoluteSessionLifetime": "10:00:00",
    "TemporaryPasswordLifetime": "3.00:00:00",
    "SecurityStampValidationInterval": "00:01:00"
  },
  "Seed": {
    "Admin": {
      "UserName": "",
      "Email": "",
      "FullName": "System Administrator"
    },
    "DevUsers": {
      "Enabled": false
    }
  }
}
