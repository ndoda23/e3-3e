@model ClientIndexViewModel
@{
    var page = Model.Clients;
    var pager = new PagerModel(
        page.Page, page.TotalPages, page.TotalCount, page.PageSize,
        n => Url.Action("Index", new { search = Model.Search, page = n })!,
        n => Url.Action("Rows", new { search = Model.Search, page = n })!,
        "#client-rows");
}
<div class="table-wrap">
    <table class="tbl">
        <caption class="sr-only">@T["Nav.Clients"]</caption>
        <thead>
            <tr>
                <th scope="col">@T["Field.FullName"]</th>
                <th scope="col">@T["Field.PersonalNumber"]</th>
                <th scope="col">@T["Field.BirthDate"]</th>
                <th scope="col">@T["Clients.Kyc"]</th>
                <th scope="col">@T["Clients.Screening"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in page.Items)
            {
                <tr data-client="@client.Id.Value">
                    <td><a class="row-link" asp-action="Details" asp-route-id="@client.Id.Value">@client.FullName</a></td>
                    <td class="mono">@client.PersonalNumber</td>
                    <td class="tnum">@DisplayFormat.Date(client.BirthDate)</td>
                    <td>@T.EnumText(client.Kyc)</td>
                    <td>@T.EnumText(client.Screening)</td>
                </tr>
            }
        </tbody>
    </table>
    @if (page.TotalCount == 0)
    {
        <div class="empty">@T["Clients.None"]</div>
    }
</div>
<partial name="_Pager" model="pager" />
