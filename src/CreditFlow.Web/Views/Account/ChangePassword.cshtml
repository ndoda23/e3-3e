@model CreditFlow.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = T["ForcedChangePassword.Title"].Value;
    ViewData["Description"] = T["ForcedChangePassword.Description"].Value;
}
<form method="post" asp-action="ChangePassword" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="form" novalidate>
    <partial name="_ChangePasswordFields" model="Model" />
    <button type="submit" class="btn primary lg block">@T["ChangePassword.Submit"]</button>
</form>
@section Footer {
    <form method="post" action="/Account/Logout" class="row">
        <span class="grow">@T["ForcedChangePassword.Footer"]</span>
        <button type="submit" class="btn sm ghost">@T["Layout.SignOut"]</button>
    </form>
}
