@model CreditFlow.Web.Models.MyAccountViewModel
@{
    ViewData["Title"] = T["Manage.Title"].Value;
    var d = Model.Details;
}
<div class="page-head">
    <div class="row">
        <avatar name="@d.FullName" size="lg" />
        <div>
            <h1 class="page-title">@d.FullName</h1>
            <p class="page-desc">@d.RoleName</p>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn" asp-action="ChangePassword"><icon name="key" size="15" />@T["Manage.ChangePassword"]</a>
        <a class="btn" asp-action="TwoFactor"><icon name="smartphone" size="15" />@T["Manage.TwoFactor"]</a>
    </div>
</div>
@if (TempData["Notice"] is string notice)
{
    <div class="alert success mb" role="status"><icon name="check" size="18" /><span>@notice</span></div>
}
<section class="card" aria-labelledby="profile-title">
    <div class="card-head">
        <div>
            <h2 class="card-title" id="profile-title">@T["Manage.Profile"]</h2>
            <p class="card-sub">@T["Manage.ProfileHint"]</p>
        </div>
    </div>
    <div class="card-body">
        <dl class="dl">
            <dt>@T["Field.UserName"]</dt><dd class="mono">@d.UserName</dd>
            <dt>@T["Field.Email"]</dt><dd>@d.Email</dd>
            <dt>@T["Field.Role"]</dt><dd>@d.RoleName</dd>
            @if (d.BranchName is { } branch)
            {
                <dt>@T["Field.Branch"]</dt><dd>@branch</dd>
            }
            <dt>@T["Field.TwoFactor"]</dt>
            <dd>
                @if (Model.TwoFactor?.Enabled == true)
                {
                    <span class="pill success"><span class="dot"></span>@T["Manage.TwoFactorOn"]</span>
                }
                else
                {
                    <span class="pill neutral"><span class="dot"></span>@T["Manage.TwoFactorOff"]</span>
                }
            </dd>
            <dt>@T["Field.LastLogin"]</dt>
            <dd>@DisplayFormat.DateTime(d.LastLoginAt)</dd>
        </dl>
    </div>
</section>
