@model InboxViewModel
@{
    ViewData["Title"] = T["Nav.Inbox"].Value;
}
<div class="page-head">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-desc">@T[$"Inbox.{Model.Current}.Description"]</p>
    </div>
</div>
@if (Model.Available.Count > 1)
{
    <nav class="tabs mb" aria-label="@T["Nav.Inbox"]">
        @foreach (var inbox in Model.Available)
        {
            <a class="tab @(inbox == Model.Current ? "active" : null)" href="@Url.Action("Index", new { inbox })"
               aria-current="@(inbox == Model.Current ? "page" : null)" data-inbox="@inbox">@T[$"Inbox.{inbox}"]</a>
        }
    </nav>
}
<section class="card" aria-label="@T[$"Inbox.{Model.Current}"]" data-current-inbox="@Model.Current">
    @if (Model.Current == CreditFlow.Application.Applications.Inbox.Underwriting)
    {
        <div class="card-head">
            <nav class="segmented" aria-label="@T["Inbox.Filter"]">
                <a class="seg @(Model.Filter is null ? "active" : null)" href="@Url.Action("Index", new { inbox = Model.Current })"
                   aria-current="@(Model.Filter is null ? "true" : null)">@T["Inbox.Filter.All"]</a>
                @foreach (var option in Enum.GetValues<CreditFlow.Application.Applications.InboxFilter>())
                {
                    <a class="seg @(Model.Filter == option ? "active" : null)" href="@Url.Action("Index", new { inbox = Model.Current, filter = option })"
                       aria-current="@(Model.Filter == option ? "true" : null)" data-inbox-filter="@option">@T[$"Inbox.Filter.{option}"]</a>
                }
            </nav>
        </div>
    }
    <div id="inbox-rows" class="tbl-body">
        <partial name="_InboxRows" model="Model" />
    </div>
</section>
