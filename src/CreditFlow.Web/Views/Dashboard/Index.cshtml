@model CreditFlow.Web.Models.DashboardViewModel
@{
    var profile = Model.Profile;
    ViewData["Title"] = T[$"Dashboard.{profile.Dashboard}"].Value;
}
<div class="page-head">
    <div>
        <span class="eyebrow" data-dashboard-chip>@profile.RoleCode · @profile.FullName</span>
        <h1 class="page-title" data-dashboard="@profile.Dashboard">@ViewData["Title"]</h1>
        <p class="page-desc">@T[$"Dashboard.{profile.Dashboard}.Description"]</p>
    </div>
</div>
<section class="card" aria-labelledby="dashboard-placeholder">
    <div class="coming-soon">
        <span class="badge-icon"><icon name="dashboard" size="22" /></span>
        <h2 class="card-title" id="dashboard-placeholder">@T["Dashboard.Placeholder.Title"]</h2>
        <p class="muted">@T["Dashboard.Placeholder.Description"]</p>
    </div>
</section>
