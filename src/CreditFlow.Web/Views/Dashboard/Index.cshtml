@model CreditFlow.Web.Models.DashboardViewModel
@{
    var profile = Model.Profile;
    ViewData["Title"] = T[$"Dashboard.{profile.Dashboard}"].Value;

    // Chip as in the prototype: "SR UW · TAMTA TATISHVILI" (upper-cased by CSS).
    var roleTag = profile.AuthorityLevel is { } level
        ? $"{T[$"AuthorityLevel.{level}.Short"].Value} {profile.RoleCode}"
        : profile.RoleCode;
    var limits = string.Join(" · ", Model.CreditLimits.Select(l => DisplayFormat.Money(l.Currency, l.MaxAmount)));
}
<div class="page-head">
    <div>
        <span class="eyebrow" data-dashboard-chip>@roleTag · @profile.FullName</span>
        <h1 class="page-title" data-dashboard="@profile.Dashboard">@ViewData["Title"]</h1>
        <p class="page-desc">
            @T[$"Dashboard.{profile.Dashboard}.Description"]
            @if (Model.ShowsAuthorityLimit)
            {
                <span data-authority-limit>
                    @if (Model.CreditLimits.Count > 0)
                    {
                        @T["Dashboard.AuthorityLimit"] <strong class="tnum">@limits</strong>
                    }
                    else
                    {
                        @T["Dashboard.AuthorityLimitNone"]
                    }
                </span>
            }
        </p>
    </div>
</div>
<section class="card" aria-labelledby="dashboard-placeholder">
    <div class="coming-soon">
        <span class="badge-icon"><icon name="dashboard" size="22" /></span>
        <h2 class="card-title" id="dashboard-placeholder">@T["Dashboard.Placeholder.Title"]</h2>
        <p class="muted">@T["Dashboard.Placeholder.Description"]</p>
    </div>
</section>
