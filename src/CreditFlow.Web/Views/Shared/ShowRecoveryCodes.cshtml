@model CreditFlow.Web.Models.RecoveryCodesViewModel
@{
    // Shown once, right after the codes were generated: from the sign-in flow (minimal layout) or from My account.
    var fromAccount = string.Equals(ViewContext.RouteData.Values["controller"] as string, "Account", StringComparison.OrdinalIgnoreCase);
    Layout = fromAccount ? "_AuthLayout" : "_Layout";
    ViewData["Title"] = T["RecoveryCodes.Title"].Value;
    ViewData["Description"] = T["RecoveryCodes.Description"].Value;
}
@if (!fromAccount)
{
    <div class="page-head"><div><h1 class="page-title">@ViewData["Title"]</h1><p class="page-desc">@ViewData["Description"]</p></div></div>
}
<div class="card">
    <div class="card-body stack">
        <div class="alert warning" role="alert">
            <icon name="alert-triangle" size="18" />
            <span>@T["RecoveryCodes.Warning"]</span>
        </div>
        <ul class="codes" aria-label="@T["RecoveryCodes.Title"]">
            @foreach (var code in Model.Codes)
            {
                <li class="mono">@code</li>
            }
        </ul>
        <a class="btn primary block" href="@Model.ContinueUrl">@T["RecoveryCodes.Continue"]</a>
    </div>
</div>
