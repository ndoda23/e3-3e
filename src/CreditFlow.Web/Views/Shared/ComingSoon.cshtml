@model string
@{
    ViewData["Title"] = T[$"Nav.{Model}"].Value;
    if (string.Equals(ViewContext.RouteData.Values["area"] as string, "Admin", StringComparison.OrdinalIgnoreCase))
    {
        ViewData["Section"] = T["Nav.Section.Administration"].Value;
    }
}
<div class="page-head">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>
</div>
<partial name="_ComingSoon" />
