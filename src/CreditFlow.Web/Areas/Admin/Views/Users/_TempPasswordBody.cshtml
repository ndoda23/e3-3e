@model TemporaryPasswordModel
<div class="modal-body">
    <div class="alert warning" role="status">
        <icon name="alert-triangle" size="18" />
        <span>@T["Users.TempPassword.ShownOnce"]</span>
    </div>
    <div class="field">
        <span class="field-label" id="temp-password-label">@T["Users.TempPassword.Label"]</span>
        <div class="secret-row">
            <output class="secret grow" id="temp-password" aria-labelledby="temp-password-label" data-temp-password>@Model.Password</output>
            <button type="button" class="btn" data-copy="#temp-password" data-copied="@T["Users.TempPassword.Copied"]">
                <icon name="file-text" size="15" />@T["Users.TempPassword.Copy"]
            </button>
        </div>
        <span class="hint">@T["Users.TempPassword.Expires", DisplayFormat.DateTime(Model.ExpiresAt)]</span>
    </div>
</div>
