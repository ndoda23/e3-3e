@model UserDetailsViewModel
@{
    var u = Model.User;
    ViewData["Title"] = u.FullName;
    ViewData["Section"] = T["Nav.Users"].Value;
    var id = u.Id.Value;

    string ConfirmUrl(UserOperation operation) => Url.Action("Confirm", new { id, operation })!;
}
<div class="page-head">
    <div class="row">
        <avatar name="@u.FullName" size="lg" />
        <div>
            <div class="row">
                <h1 class="page-title">@u.FullName</h1>
                <partial name="_UserState" model="(u.IsActive, u.IsLockedOut)" />
                @if (Model.IsSelf)
                {
                    <span class="chip">@T["Users.You"]</span>
                }
            </div>
            <p class="page-desc"><span class="mono">@u.UserName</span> · @u.Email</p>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn" asp-action="Index"><icon name="chevron-left" size="15" />@T["Users.BackToList"]</a>
        <a asp-permission="@Permissions.Admin.UsersManage" class="btn primary" asp-action="Edit" asp-route-id="@id">
            <icon name="edit" size="15" />@T["Users.Edit"]
        </a>
    </div>
</div>
@if (TempData["Notice"] is string notice)
{
    <div class="alert success mb" role="status"><icon name="check" size="18" /><span>@notice</span></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert danger mb" role="alert"><icon name="alert-triangle" size="18" /><span>@error</span></div>
}
<div class="grid-2 mb">
    <section class="card" aria-labelledby="profile-title">
        <div class="card-head">
            <h2 class="card-title" id="profile-title">@T["Users.Profile"]</h2>
        </div>
        <div class="card-body">
            <dl class="dl">
                <dt>@T["Field.Role"]</dt><dd>@u.RoleName <span class="code">@u.RoleCode</span></dd>
                <dt>@T["Field.Branch"]</dt><dd>@(u.BranchName ?? DisplayFormat.Empty)</dd>
                <dt>@T["Field.Capacity"]</dt><dd class="tnum">@u.Capacity</dd>
                <dt>@T["Users.Column.Working"]</dt>
                <dd><partial name="_AvailabilityToggle" model="new AvailabilityToggleModel(u.Id, u.FullName, u.IsAvailable, u.IsActive, Model.CanManage)" /></dd>
                <dt>@T["Users.CreatedAt"]</dt><dd>@DisplayFormat.DateTime(u.CreatedAt)</dd>
                <dt>@T["Users.UpdatedAt"]</dt><dd>@DisplayFormat.DateTime(u.UpdatedAt)</dd>
            </dl>
        </div>
    </section>

    <section class="card" aria-labelledby="security-title">
        <div class="card-head">
            <h2 class="card-title" id="security-title">@T["Users.Security"]</h2>
        </div>
        <div class="card-body stack">
            <dl class="dl">
                <dt>@T["Field.LastLogin"]</dt>
                <dd>@(u.LastLoginAt is null ? T["Users.NeverSignedIn"].Value : DisplayFormat.DateTime(u.LastLoginAt))</dd>
                <dt>@T["Field.Password"]</dt>
                <dd>
                    @if (u.MustChangePassword)
                    {
                        <span class="pill warning"><span class="dot"></span>@T["Users.TemporaryPassword"]</span>
                        @if (u.TemporaryPasswordExpiresAt is { } expires)
                        {
                            <div class="small">@T["Users.TemporaryPasswordExpires", DisplayFormat.DateTime(expires)]</div>
                        }
                    }
                    else
                    {
                        <span class="pill neutral"><span class="dot"></span>@T["Users.PasswordSet"]</span>
                    }
                </dd>
                <dt>@T["Field.TwoFactor"]</dt>
                <dd>
                    <div class="row wrap">
                        @if (u.TwoFactorEnabled)
                        {
                            <span class="pill success"><span class="dot"></span>@T["Users.MfaEnrolled"]</span>
                        }
                        else
                        {
                            <span class="pill neutral"><span class="dot"></span>@T["Users.MfaNotEnrolled"]</span>
                        }
                        @if (u.RoleRequiresMfa)
                        {
                            <span class="pill info"><span class="dot"></span>@T["Users.MfaRequiredByRole"]</span>
                        }
                        else if (u.RequireMfa)
                        {
                            <span class="pill info"><span class="dot"></span>@T["Users.MfaRequiredForUser"]</span>
                        }
                    </div>
                </dd>
                @if (u.IsLockedOut && u.LockoutEnd is { } lockoutEnd)
                {
                    <dt>@T["Users.LockedUntil"]</dt><dd>@DisplayFormat.DateTime(lockoutEnd)</dd>
                }
            </dl>

            <div asp-permission="@Permissions.Admin.UsersManage" class="action-list">
                <h3 class="field-label">@T["Users.Actions"]</h3>
                <div class="row wrap">
                    <a class="btn sm" href="@ConfirmUrl(UserOperation.ResetPassword)" hx-get="@ConfirmUrl(UserOperation.ResetPassword)" hx-target="#modal-host">
                        <icon name="key" size="14" />@T["Users.ResetPassword"]
                    </a>
                    <a class="btn sm" href="@ConfirmUrl(UserOperation.ForceSignOut)" hx-get="@ConfirmUrl(UserOperation.ForceSignOut)" hx-target="#modal-host">
                        <icon name="log-out" size="14" />@T["Users.ForceSignOut"]
                    </a>
                    @if (u.IsLockedOut)
                    {
                        <form method="post" asp-action="Unlock" asp-route-id="@id">
                            <button type="submit" class="btn sm"><icon name="unlock" size="14" />@T["Users.Unlock"]</button>
                        </form>
                    }
                    @if (!u.RoleRequiresMfa)
                    {
                        <form method="post" asp-action="RequireMfa" asp-route-id="@id">
                            <input type="hidden" name="require" value="@(u.RequireMfa ? "false" : "true")" />
                            <button type="submit" class="btn sm">
                                <icon name="smartphone" size="14" />@(u.RequireMfa ? T["Users.StopRequiringMfa"] : T["Users.RequireMfa"])
                            </button>
                        </form>
                    }
                    @if (u.IsActive)
                    {
                        @if (!Model.IsSelf)
                        {
                            <a class="btn sm danger" href="@ConfirmUrl(UserOperation.Deactivate)" hx-get="@ConfirmUrl(UserOperation.Deactivate)" hx-target="#modal-host">
                                <icon name="user-x" size="14" />@T["Users.Deactivate"]
                            </a>
                        }
                    }
                    else
                    {
                        <form method="post" asp-action="Activate" asp-route-id="@id">
                            <button type="submit" class="btn sm"><icon name="user-check" size="14" />@T["Users.Activate"]</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </section>
</div>
<partial name="_RecentActivity" model="new RecentActivityViewModel(u.Id, Model.RecentActivity)" />
