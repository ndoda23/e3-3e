@model TemporaryPasswordModel
@{
    var detailsUrl = Url.Action("Details", new { id = Model.UserId.Value });
}
<div class="modal-backdrop">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="password-title" tabindex="-1">
        <div class="modal-head">
            <span class="modal-icon success"><icon name="key" size="20" /></span>
            <div>
                <h2 class="modal-title" id="password-title">@(Model.IsNewUser ? T["Users.Created.Title"] : T["Users.PasswordReset.Title"])</h2>
                <p class="modal-sub">@Model.FullName · <span class="mono">@Model.UserName</span></p>
            </div>
        </div>
        <partial name="_TempPasswordBody" model="Model" />
        <div class="modal-foot">
            <a class="btn primary" href="@detailsUrl">@T["Users.Done"]</a>
        </div>
    </div>
</div>
