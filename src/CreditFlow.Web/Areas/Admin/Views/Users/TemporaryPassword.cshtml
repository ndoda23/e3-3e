@model TemporaryPasswordModel
@{
    ViewData["Title"] = (Model.IsNewUser ? T["Users.Created.Title"] : T["Users.PasswordReset.Title"]).Value;
    ViewData["Section"] = T["Nav.Users"].Value;
}
<div class="page-head">
    <div class="row">
        <avatar name="@Model.FullName" size="lg" />
        <div>
            <h1 class="page-title">@ViewData["Title"]</h1>
            <p class="page-desc">@Model.FullName · <span class="mono">@Model.UserName</span></p>
        </div>
    </div>
</div>
<section class="card form-card">
    <partial name="_TempPasswordBody" model="Model" />
    <div class="modal-foot">
        <a class="btn" asp-action="Create" asp-permission="@Permissions.Admin.UsersManage">@T["Users.CreateAnother"]</a>
        <a class="btn primary" asp-action="Details" asp-route-id="@Model.UserId.Value">@T["Users.Done"]</a>
    </div>
</section>
