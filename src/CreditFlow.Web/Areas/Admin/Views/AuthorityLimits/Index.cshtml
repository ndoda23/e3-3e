@model CreditFlow.Application.AuthorityLimits.AuthorityLimitOverview
@{
    ViewData["Title"] = T["Nav.AuthorityLimits"].Value;
    ViewData["Section"] = T["Nav.Section.Administration"].Value;

    string ConfirmUrl(CreditFlow.Domain.AuthorityLimits.AuthorityLimitId id) => Url.Action("ConfirmDelete", new { id = id.Value })!;
}
<div class="page-head">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-desc">@T["AuthorityLimits.Description"]</p>
    </div>
</div>
@if (TempData["Notice"] is string notice)
{
    <div class="alert success mb" role="status"><icon name="check" size="18" /><span>@notice</span></div>
}

<section class="card mb" aria-labelledby="credit-title">
    <div class="card-head">
        <div>
            <h2 class="card-title" id="credit-title">@T["AuthorityLimits.Credit"]</h2>
            <p class="card-sub">@T["AuthorityLimits.CreditHint"]</p>
        </div>
        <div class="card-tools">
            <a class="btn sm primary" asp-action="CreateCredit"><icon name="plus" size="14" />@T["AuthorityLimits.NewCredit"]</a>
        </div>
    </div>
    <div class="table-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th scope="col">@T["Field.Role"]</th>
                    <th scope="col">@T["Field.AuthorityLevel"]</th>
                    <th scope="col">@T["Field.Currency"]</th>
                    <th scope="col" class="num">@T["Field.MaxAmount"]</th>
                    <th scope="col"><span class="sr-only">@T["Common.Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var limit in Model.CreditDecision)
                {
                    <tr data-limit="@limit.RoleCode-@limit.AuthorityLevel-@limit.Currency">
                        <td>@limit.RoleName <span class="code">@limit.RoleCode</span></td>
                        <td>@(limit.AuthorityLevel is { } level ? T[$"AuthorityLevel.{level}"].Value : T["AuthorityLimits.AnyLevel"].Value)</td>
                        <td>@limit.Currency</td>
                        <td class="num mono">@(limit.Currency is { } currency && limit.MaxAmount is { } max ? DisplayFormat.Money(currency, max) : DisplayFormat.Empty)</td>
                        <td class="actions">
                            <a class="btn sm" asp-action="EditCredit" asp-route-id="@limit.Id.Value"><icon name="edit" size="14" />@T["Common.Edit"]</a>
                            <a class="icon-btn plain" href="@ConfirmUrl(limit.Id)" hx-get="@ConfirmUrl(limit.Id)" hx-target="#modal-host" title="@T["AuthorityLimits.Delete.Button"]">
                                <icon name="x" size="16" label="@T["AuthorityLimits.Delete.Button"]" />
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.CreditDecision.Count == 0)
        {
            <div class="empty">@T["AuthorityLimits.NoCredit"]</div>
        }
    </div>
</section>

<section class="card" aria-labelledby="pricing-title">
    <div class="card-head">
        <div>
            <h2 class="card-title" id="pricing-title">@T["AuthorityLimits.Pricing"]</h2>
            <p class="card-sub">@T["AuthorityLimits.PricingHint"]</p>
        </div>
        <div class="card-tools">
            <a class="btn sm primary" asp-action="CreatePricing"><icon name="plus" size="14" />@T["AuthorityLimits.NewPricing"]</a>
        </div>
    </div>
    <div class="table-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th scope="col">@T["Field.Role"]</th>
                    <th scope="col">@T["Field.MaxRateGapPp"]</th>
                    <th scope="col">@T["Field.MinCustomerRoaePct"]</th>
                    <th scope="col"><span class="sr-only">@T["Common.Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var limit in Model.PricingException)
                {
                    <tr data-limit="@limit.RoleCode-Pricing">
                        <td>@limit.RoleName <span class="code">@limit.RoleCode</span></td>
                        <td>@(limit.MaxRateGapPp is { } gap ? T["AuthorityLimits.GapBelow", gap.ToString("0.##")].Value : T["AuthorityLimits.NoLimit"].Value)</td>
                        <td>@(limit.MinCustomerRoaePct is { } roae ? T["AuthorityLimits.RoaeAtLeast", roae.ToString("0.##")].Value : T["AuthorityLimits.NoLimit"].Value)</td>
                        <td class="actions">
                            <a class="btn sm" asp-action="EditPricing" asp-route-id="@limit.Id.Value"><icon name="edit" size="14" />@T["Common.Edit"]</a>
                            <a class="icon-btn plain" href="@ConfirmUrl(limit.Id)" hx-get="@ConfirmUrl(limit.Id)" hx-target="#modal-host" title="@T["AuthorityLimits.Delete.Button"]">
                                <icon name="x" size="16" label="@T["AuthorityLimits.Delete.Button"]" />
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.PricingException.Count == 0)
        {
            <div class="empty">@T["AuthorityLimits.NoPricing"]</div>
        }
    </div>
</section>
