@model CreditLimitForm
@{
    var existing = Model.Existing;
    ViewData["Title"] = (existing is null ? T["AuthorityLimits.NewCredit"] : T["AuthorityLimits.EditCredit"]).Value;
    ViewData["Section"] = T["Nav.AuthorityLimits"].Value;
}
<div class="page-head">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-desc">@T["AuthorityLimits.CreditFormHint"]</p>
    </div>
</div>
<section class="card form-card">
    <form method="post" asp-action="@(existing is null ? "CreateCredit" : "EditCredit")" asp-route-id="@existing?.Id.Value" class="card-body form" novalidate>
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <div class="form-grid">
            @if (existing is null)
            {
                <div class="field full">
                    <label asp-for="RoleId" class="required"></label>
                    <select asp-for="RoleId" class="inp">
                        <option value="">@T["Users.ChooseRole"]</option>
                        @foreach (var role in Model.Roles)
                        {
                            var byLevel = role.AuthorityLevelRule != AttributeRule.NotAllowed;
                            <option value="@role.Id">@role.Name (@role.Code)@(byLevel ? T["AuthorityLimits.ByLevel"].Value : null)</option>
                        }
                    </select>
                    <span asp-validation-for="RoleId"></span>
                </div>
                <div class="field">
                    <label asp-for="AuthorityLevel"></label>
                    <select asp-for="AuthorityLevel" class="inp" aria-describedby="limit-level-hint">
                        <option value="">@T["AuthorityLimits.NoLevelOption"]</option>
                        @foreach (var level in Enum.GetValues<AuthorityLevel>())
                        {
                            <option value="@level">@T[$"AuthorityLevel.{level}"]</option>
                        }
                    </select>
                    <span id="limit-level-hint" class="hint">@T["AuthorityLimits.LevelHint"]</span>
                    <span asp-validation-for="AuthorityLevel"></span>
                </div>
                <div class="field">
                    <label asp-for="Currency" class="required"></label>
                    <select asp-for="Currency" class="inp">
                        @foreach (var currency in Enum.GetValues<Lams.Domain.AuthorityLimits.Currency>())
                        {
                            <option value="@currency">@currency (@DisplayFormat.CurrencySymbol(currency))</option>
                        }
                    </select>
                    <span asp-validation-for="Currency"></span>
                </div>
            }
            else
            {
                <dl class="dl full">
                    <dt>@T["Field.Role"]</dt><dd>@existing.RoleName <span class="code">@existing.RoleCode</span></dd>
                    <dt>@T["Field.AuthorityLevel"]</dt><dd>@(existing.AuthorityLevel is { } level ? T[$"AuthorityLevel.{level}"].Value : T["AuthorityLimits.AnyLevel"].Value)</dd>
                    <dt>@T["Field.Currency"]</dt><dd>@existing.Currency</dd>
                </dl>
            }
            <div class="field">
                <label asp-for="MaxAmount" class="required"></label>
                <input asp-for="MaxAmount" type="number" min="0" step="0.01" class="inp tnum" aria-describedby="max-amount-hint" />
                <span id="max-amount-hint" class="hint">@T["AuthorityLimits.MaxAmountHint"]</span>
                <span asp-validation-for="MaxAmount"></span>
            </div>
        </div>
        <div class="form-actions">
            <a class="btn" asp-action="Index">@T["Common.Cancel"]</a>
            <button type="submit" class="btn primary"><icon name="check" size="15" />@T["Common.Save"]</button>
        </div>
    </form>
</section>
