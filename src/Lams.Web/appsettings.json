{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "LAMS" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Lams": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Security": {
    "IdleTimeout": "00:30:00",
    "AbsoluteSessionLifetime": "10:00:00",
    "TemporaryPasswordLifetime": "3.00:00:00",
    "SecurityStampValidationInterval": "00:01:00"
  },
  "Seed": {
    "Admin": {
      "UserName": "",
      "Email": "",
      "FullName": "System Administrator"
    },
    "DevUsers": {
      "Enabled": false
    }
  }
}
