@model Lams.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = T["Manage.ChangePassword"].Value;
}
<div class="page-head">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-desc">@T["Manage.ChangePasswordHint"]</p>
    </div>
</div>
<section class="card narrow">
    <div class="card-body">
        <form method="post" asp-action="ChangePassword" class="form" novalidate>
            <partial name="_ChangePasswordFields" model="Model" />
            <div class="row">
                <button type="submit" class="btn primary">@T["ChangePassword.Submit"]</button>
                <a class="btn ghost" asp-action="Index">@T["Common.Cancel"]</a>
            </div>
        </form>
    </div>
</section>
