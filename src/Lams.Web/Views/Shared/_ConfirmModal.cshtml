@model Lams.Web.Models.ConfirmModel
<div class="modal-backdrop">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-desc" tabindex="-1">
        <div class="modal-head">
            <span class="modal-icon @(Model.IsDangerous ? "danger" : "warning")"><icon name="@Model.Icon" size="20" /></span>
            <div>
                <h2 class="modal-title" id="confirm-title">@Model.Title</h2>
                <p class="modal-sub">@Model.Subject</p>
            </div>
        </div>
        <div class="modal-body">
            <p id="confirm-desc">@Model.Description</p>
        </div>
        <form class="modal-foot" method="post" action="@Model.ActionUrl">
            @Html.AntiForgeryToken()
            <a class="btn" href="@Model.CancelUrl" data-close-modal>@T["Common.Cancel"]</a>
            <button type="submit" class="btn @(Model.IsDangerous ? "danger-solid" : "primary")" autofocus>@Model.ButtonText</button>
        </form>
    </div>
</div>
