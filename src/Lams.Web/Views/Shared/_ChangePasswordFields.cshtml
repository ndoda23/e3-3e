@model Lams.Web.Models.ChangePasswordViewModel
<div asp-validation-summary="ModelOnly" role="alert"></div>
<div class="field">
    <label asp-for="CurrentPassword" class="required"></label>
    <input asp-for="CurrentPassword" class="inp" autocomplete="current-password" autofocus />
    <span asp-validation-for="CurrentPassword"></span>
</div>
<div class="field">
    <label asp-for="NewPassword" class="required"></label>
    <input asp-for="NewPassword" class="inp" autocomplete="new-password" aria-describedby="password-rules" />
    <span id="password-rules" class="hint">@T["ChangePassword.Rules"]</span>
    <span asp-validation-for="NewPassword"></span>
</div>
<div class="field">
    <label asp-for="ConfirmPassword" class="required"></label>
    <input asp-for="ConfirmPassword" class="inp" autocomplete="new-password" />
    <span asp-validation-for="ConfirmPassword"></span>
</div>
